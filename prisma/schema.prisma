generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id           Int           @id @default(autoincrement())
  nome         String
  email        String        @unique
  token        String?
  tipo         TipoUsuario   @default(PARTICIPANTE)
  criadoEm     DateTime      @default(now()) @map("criado_em")
  atualizadoEm DateTime      @updatedAt @map("atualizado_em")
  participante  Participante?
  pesquisador   Pesquisador?
  administrador Administrador?

  @@map("usuario")
}

model Participante {
  id             Int               @id @default(autoincrement())
  usuarioId      Int               @unique @map("usuario_id")
  cpf            String            @unique
  senha          String
  dataAdesao     DateTime          @default(now()) @map("data_adesao")
  /**
   * Data de nascimento informada no cadastro (usada para idade/faixa etária no
   * Painel do Pesquisador). Opcional porque participantes cadastrados antes
   * desse campo existir não têm esse dado — nesse caso os cards do painel que
   * dependem de idade exibem "Sem dados" em vez de inventar um valor.
   */
  dataNascimento DateTime?         @map("data_nascimento") @db.Date
  /**
   * Sexo declarado no cadastro (usado na distribuição por sexo do Painel do
   * Pesquisador). Não confundir com `PerfilGamificado.avatarGenero`, que é
   * apenas a escolha estética do avatar dentro do aplicativo.
   */
  sexo           Sexo?             @map("sexo")
  /**
   * Token do Expo Push Notifications do dispositivo mais recente em que o
   * participante fez login. Usado pelo agendador de notificações (lembrete
   * padrão, lembrete repetido e lembrete semanal) para enviar push "fora do
   * app". Fica nulo quando o participante nunca autorizou notificações ou
   * fez logout (nesse caso o token é removido).
   */
  expoPushToken  String?           @map("expo_push_token")
  /**
   * Data (sem hora) do último envio de cada tipo de lembrete, usada só para
   * não enviar o mesmo lembrete duas vezes no mesmo dia/semana. Não tem
   * relação com a pesquisa, é apenas controle interno do agendador.
   */
  ultimoLembretePadraoEnviadoEm   DateTime? @map("ultimo_lembrete_padrao_enviado_em") @db.Timestamptz(3)
  ultimoLembreteRepetidoEnviadoEm DateTime? @map("ultimo_lembrete_repetido_enviado_em") @db.Timestamptz(3)
  ultimoLembreteSemanalEnviadoEm  DateTime? @map("ultimo_lembrete_semanal_enviado_em") @db.Timestamptz(3)
  usuario        Usuario           @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  perfil         PerfilGamificado?
  sessoes        SessaoTreino[]

  @@map("participante")
}

model PerfilGamificado {
  participanteId Int          @id @map("participante_id")
  avatarGenero   GeneroAvatar @map("avatar_genero")
  nomeAvatar     String?      @map("nome_avatar")
  faseAtual      FaseTreino   @default(INICIANTE) @map("fase_atual")
  nivelAtual     Int          @default(1) @map("nivel_atual")
  pontos         Int          @default(0)
  estrelas       Int          @default(0)
  medalhas       Int          @default(0)
  trofeus        Int          @default(0)
  participante   Participante @relation(fields: [participanteId], references: [id], onDelete: Cascade)

  @@map("perfil_gamificado")
}

model Pesquisador {
  id           Int         @id @default(autoincrement())
  usuarioId    Int         @unique @map("usuario_id")
  senha        String?
  exercicios   Exercicio[]
  usuario      Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("pesquisador")
}

model Administrador {
  id        Int     @id @default(autoincrement())
  usuarioId Int     @unique @map("usuario_id")
  senha     String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("administrador")
}

model Categoria {
  id         Int         @id @default(autoincrement())
  nome       String      @unique
  exercicios Exercicio[]

  @@map("categoria")
}

model Exercicio {
  id            Int               @id @default(autoincrement())
  pesquisadorId Int               @map("pesquisador_id")
  categoriaId   Int               @map("categoria_id")
  nome          String
  videoUrl      String            @map("video_url")
  instrucao     String[]          @map("instrucao")
  ativo       Boolean           @default(true)
  categoria     Categoria         @relation(fields: [categoriaId], references: [id])
  pesquisador   Pesquisador       @relation(fields: [pesquisadorId], references: [id])
  treinos       TreinoExercicio[]
  sessoes       SessaoExercicio[]

  @@map("exercicio")
}

model Treino {
  id                     Int               @id @default(autoincrement())
  nome                   String
  instrucao              String
  fase                   FaseTreino
  nivel                  Int
  quantidadeSemanas      Int               @map("quantidade_semanas")
  duracaoEstimadaMinutos Int               @map("duracao_estimada_minutos")
  ativo                  Boolean           @default(true)
  sessoes                SessaoTreino[]
  exercicios             TreinoExercicio[]

  @@map("treino")
}

model TreinoExercicio {
  id                      Int       @id @default(autoincrement())
  treinoId                Int       @map("treino_id")
  exercicioId             Int       @map("exercicio_id")
  ordem                   Int
  series                  Int
  descansoSegundos        Int       @map("descanso_segundos")
  descansoTransicaoSegundos Int     @default(30) @map("descanso_transicao_segundos")
  multiplicadorVelocidade Float     @map("multiplicador_velocidade")
  /// Velocidade de reprodução do vídeo do exercício neste treino (1 = original, 0.5 = metade, 2 = dobro).
  velocidadeExecucao      Float     @default(1) @map("velocidade_execucao")
  exercicio               Exercicio @relation(fields: [exercicioId], references: [id], onDelete: Cascade)
  treino                  Treino    @relation(fields: [treinoId], references: [id], onDelete: Cascade)

  @@unique([treinoId, exercicioId])
  @@map("treino_exercicio")
}

model SessaoTreino {
  id                     Int              @id @default(autoincrement())
  participanteId         Int              @map("participante_id")
  treinoId               Int              @map("treino_id")
  dataInicio             DateTime         @default(now()) @map("data_inicio") @db.Timestamptz(3)
  dataFim                DateTime?        @map("data_fim") @db.Timestamptz(3)
  tempoRealizadoSegundos Int?             @map("tempo_realizado_segundos")
  percentualConcluido    Float            @default(0) @map("percentual_concluido")
  status                 StatusSessao     @default(EM_ANDAMENTO)
  esforcoOmni            Int?             @map("esforco_omni")
  pontosGanhos           Int              @default(0) @map("pontos_ganhos")
  /**
   * Controla a "terceira mensagem" do fluxo de finalização antecipada (1% a
   * 49% do treino): "Quando você retornar por aqui, deseja refazer esse
   * treino?". Marcado como true depois que a pergunta aparece uma vez na
   * tela inicial, para não repetir em todo login. Só é relevante quando
   * status = INTERROMPIDA e percentualConcluido < 50.
   */
  perguntaRefazerExibida Boolean          @default(false) @map("pergunta_refazer_exibida")
  participante           Participante     @relation(fields: [participanteId], references: [id])
  treino                 Treino           @relation(fields: [treinoId], references: [id])
  exercicios             SessaoExercicio[]

  @@map("sessao_treino")
}

model SessaoExercicio {
  sessaoId          Int      @map("sessao_id")
  exercicioId       Int      @map("exercicio_id")
  seriesConcluidas  Int      @default(0) @map("series_concluidas")
  concluido         Boolean  @default(false)
  sessao            SessaoTreino @relation(fields: [sessaoId], references: [id], onDelete: Cascade)
  exercicio         Exercicio    @relation(fields: [exercicioId], references: [id], onDelete: Cascade)

  @@id([sessaoId, exercicioId])
  @@map("sessao_exercicio")
}

enum TipoUsuario {
  PESQUISADOR
  PARTICIPANTE
  ADMIN
}

enum GeneroAvatar {
  FEMININO
  MASCULINO
}

/** Sexo declarado pelo participante no cadastro (dado demográfico da pesquisa). */
enum Sexo {
  FEMININO
  MASCULINO
}

enum FaseTreino {
  INICIANTE
  INTERMEDIARIO
  AVANCADO
}

enum StatusSessao {
  EM_ANDAMENTO
  CONCLUIDA
  INCOMPLETA
  INTERROMPIDA
}
